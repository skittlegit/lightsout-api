__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
.env.local

# FastF1 cache
fastf1_cache/

# Model artifacts & training data
ml/artifacts/*.pkl
ml/artifacts/.tmp/
ml/data/*.parquet
# ...but the two training sets must ship with the repo: the API loads them at
# runtime for historical context (_load_history). Without them, deploys fall
# back to neutral features and predictions come out flat. Checkpoints stay ignored.
!ml/data/training.parquet
!ml/data/quali_training.parquet

