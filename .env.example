# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Upstream data provider
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Monte Carlo
MC_SIMULATIONS=10000

# Model artifact paths (relative to repo root)
MODEL_PRE_QUALI_PATH=ml/artifacts/pre_quali_finish.pkl
MODEL_POST_QUALI_PATH=ml/artifacts/post_quali_finish.pkl
MODEL_POLE_PATH=ml/artifacts/pole.pkl

# FastF1 cache directory
FASTF1_CACHE_DIR=./fastf1_cache

# Auth — required for /retrain and /refresh
RETRAIN_API_KEY=change-me-in-production
